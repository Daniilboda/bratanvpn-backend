# Copy to repo root as `.env` for Docker Compose (never commit real secrets).
# Local uvicorn can keep using backend/.env separately.

# --- Compose / public site ---
SITE_ADDRESS=api.bratanvpn.com
# Local HTTP-only smoke test (no real TLS): SITE_ADDRESS=:80

POSTGRES_DB=bratanvpn
POSTGRES_USER=bratanvpn
POSTGRES_PASSWORD=change-me-strong-password

# --- Backend (also used inside the backend container) ---
APP_NAME=BratanVPN API
APP_VERSION=0.1.0
DEBUG=false
# DATABASE_URL is set automatically in compose for service `backend`.
# For local uvicorn against published Postgres:
# DATABASE_URL=postgresql+asyncpg://bratanvpn:change-me-strong-password@127.0.0.1:5433/bratanvpn
ADMIN_API_KEY=change-me-admin-api-key

VPN_SERVER_NAME=Основной
VPN_SERVER_HOST=vpn.example.com
VPN_SERVER_PORT=51820
VPN_SERVER_PUBLIC_KEY=change-me-server-public-key

VPN_JC=4
VPN_JMIN=64
VPN_JMAX=1024
VPN_S1=32
VPN_S2=48
VPN_S3=24
VPN_S4=12
VPN_H1=1234567891
VPN_H2=1234567892
VPN_H3=1234567893
VPN_H4=1234567894
VPN_I1=

# Docker on same VPS: SSH into the host agent (AmneziaWG stays on the host).
VPN_AGENT_MODE=ssh
VPN_AGENT_PATH=/usr/local/sbin/bratanvpn-awg-agent
VPN_AGENT_SSH_HOST=host.docker.internal
VPN_AGENT_SSH_USER=root
VPN_AGENT_SSH_PASSWORD=change-me
VPN_AGENT_SSH_PORT=22

# If backend runs on the host (not in Docker), you can use:
# VPN_AGENT_MODE=local
# VPN_AGENT_PATH=/usr/local/sbin/bratanvpn-awg-agent

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_COOLDOWN_SECONDS=900
HEALTH_DISK_MIN_MB=500
